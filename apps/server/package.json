{
  "name": "@rivalrush/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RivalRush game server: Telegram auth, rooms, Socket.IO realtime, game engine, stats.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "beta:report": "tsx --conditions=source src/analytics/betaReportCli.ts",
    "test:defuser:full": "DEFUSER_SEEDS=100000 DEFUSER_ORACLE_SAMPLES=200000 DEFUSER_VIEW_SEEDS=10000 vitest run test/unit/defuser-generator.test.ts test/unit/defuser-oracle.test.ts test/unit/defuser-views.test.ts"
  },
  "dependencies": {
    "@rivalrush/shared": "0.1.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.4",
    "pino": "10.4.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "8.0.32"
    }
  }
}
