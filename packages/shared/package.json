{
  "name": "@rivalrush/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Types, DTOs, socket events and validation shared by the RivalRush server and web app.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  }
}
