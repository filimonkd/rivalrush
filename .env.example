# Copy to apps/server/.env for local development. Never commit real values.
# The server refuses to start in production with insecure settings.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave empty in development to use a throwaway in-memory MongoDB replica set.
MONGODB_URI=
# MONGODB_DB_NAME=rivalrush_dev

# Telegram (use a separate DEVELOPMENT bot from @BotFather, never the production one).
BOT_TOKEN=
BOT_USERNAME=
# off | polling (local dev, no public URL needed) | webhook (hosted; needs PUBLIC_URL)
BOT_MODE=off
WEBAPP_URL=
# This server's public https URL (webhook target). On Render, RENDER_EXTERNAL_URL is used.
PUBLIC_URL=

# >= 32 random characters in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=
AUTH_MAX_AGE_SECONDS=3600

# Exact web app origin(s), comma separated. https only in production.
CLIENT_ORIGINS=http://localhost:5173

# Development-only login shortcut (?dev=Alice). Forbidden in production.
DEV_LOGIN_ENABLED=true

# Defuser (co-op) has no UI yet. Dev/test only; the server refuses both in production.
# DEFUSER_ENABLED=true registers the plug-in (it is still never advertised).
# DEFUSER_FIXED_SEED=<32 lowercase hex> makes every Defuser game identical (never log it).
# DEFUSER_ENABLED=false
# DEFUSER_FIXED_SEED=

DISCONNECT_GRACE_SECONDS=60
ROOM_TTL_MINUTES=120
