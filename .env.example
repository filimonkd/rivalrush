# Copy to apps/server/.env for local development. Never commit real values.
# The server refuses to start in production with insecure settings.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave empty in development to use a throwaway in-memory MongoDB replica set.
MONGODB_URI=
# MONGODB_DB_NAME=rivalrush_dev

# Telegram (use a separate DEVELOPMENT bot from @BotFather, never the production one).
BOT_TOKEN=
BOT_USERNAME=
BOT_POLLING=false
WEBAPP_URL=

# >= 32 random characters in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=
AUTH_MAX_AGE_SECONDS=3600

# Exact web app origin(s), comma separated. https only in production.
CLIENT_ORIGINS=http://localhost:5173

# Development-only login shortcut (?dev=Alice). Forbidden in production.
DEV_LOGIN_ENABLED=true

DISCONNECT_GRACE_SECONDS=60
ROOM_TTL_MINUTES=120
